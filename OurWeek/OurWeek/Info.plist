<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
	</array>
	<key>CKSharingSupported</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.kalebjensen.OurWeek</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>ourweek</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Our Week uses the camera to turn a photo of a recipe into a recipe you can save.</string>
	<key>NSCalendarsUsageDescription</key>
	<string>OurWeek uses your calendar to show and sync events across your household.</string>
	<key>NSCalendarsFullAccessUsageDescription</key>
	<string>OurWeek uses your calendar to show and sync events across your household.</string>
	<key>NSRemindersUsageDescription</key>
	<string>Our Week adds your to-dos to Apple Reminders and brings changes back when you turn Reminders on.</string>
	<key>NSRemindersFullAccessUsageDescription</key>
	<string>Our Week adds your to-dos to Apple Reminders and brings changes back when you turn Reminders on.</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Our Week Recipe Pack</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.json</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
